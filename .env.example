# ============================================================
# Ядро ASIC Control — секреты и настройки.
# Этот файл копируется в .env и живёт ТОЛЬКО на сервере.
# Пароли асиков в приложение на iPhone не попадают.
# ============================================================

# --- Сервер ядра ---
CORE_HOST=0.0.0.0
CORE_PORT=8486

# Токен доступа приложения к ядру. Придумайте длинную строку.
# Пример: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=CHANGE_ME_LONG_SECRET

# --- Локация асиков ---
# Статический белый IP локации. К каждому асику ядро ходит как
# http://LOCATION_IP:PORT  (порт задаётся в miners.json)
LOCATION_IP=1.2.3.4

# Таймаут HTTP-запроса к асику, секунды
MINER_TIMEOUT_SECONDS=8

# --- Логины и пароли прошивок ---
# Stock Antminer (S19k Pro и т.п.). Обычно root / root
ANTMINER_USER=root
ANTMINER_PASSWORD=root

# Vnish. Обычно пароль admin, логин не нужен
VNISH_PASSWORD=admin

# Если у конкретного асика свой пароль — раскомментируйте
# и укажите id из miners.json:
# MINER_ASIC1_USER=root
# MINER_ASIC1_PASSWORD=другой_пароль
# MINER_VNISH1_PASSWORD=другой_пароль

# --- Мониторинг ---
# Проверка хэшрейта раз в 10 минут
POLL_INTERVAL_SECONDS=600

# После перезагрузки ждать 10 минут (не трогать асик повторно)
REBOOT_COOLDOWN_SECONDS=600

# Автоперезагрузка без вашего участия
AUTO_REBOOT_ENABLED=true

# Пуш, если хэшрейт ниже этой доли от expected_ths в miners.json
# 0.7 = ниже 70% от нормы
HASHRATE_ALERT_RATIO=0.7

# Авторебут, если хэшрейт ниже этой доли или асик не отвечает
# 0.3 = ниже 30% от нормы (сильное падение)
HASHRATE_REBOOT_RATIO=0.3

# Защита от цикла ребутов: не больше N авторебутов за окно
MAX_AUTO_REBOOTS=3
AUTO_REBOOT_WINDOW_SECONDS=7200

# --- Пуш-уведомления (можно включить несколько сразу) ---

# 1) ntfy — самое простое для iPhone.
#    Поставьте приложение ntfy из App Store, подпишитесь на тему ниже.
#    Тема должна быть секретной, как пароль.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# 2) Telegram-бот
#    1. @BotFather → /newbot → скопируйте токен
#    2. Напишите боту /start
#    3. chat_id: напишите @userinfobot или откройте
#       https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Файл со списком асиков (порты, прошивки, пороги)
MINERS_FILE=miners.json
