[Unit]
Description=ASIC Control core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/asic-control/core
EnvironmentFile=/opt/asic-control/.env
ExecStart=/opt/asic-control/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8486
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
